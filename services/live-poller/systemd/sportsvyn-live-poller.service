# sportsvyn-live-poller.service
#
# INSTALL (on the droplet, as root):
#   cp services/live-poller/systemd/sportsvyn-live-poller.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now sportsvyn-live-poller
#   journalctl -u sportsvyn-live-poller -f
#
# INSTALLED AS A --user UNIT INSTEAD, 1 Sep 2026, because this box has no
# passwordless sudo and a system unit needs root. Same file, three differences,
# and `loginctl enable-linger derik` (which a user may do for itself) is what
# makes it survive logout and reboot:
#   cp .../sportsvyn-live-poller.service ~/.config/systemd/user/
#   sed -i 's/^User=derik$/# user unit/;s/multi-user.target/default.target/' ...
#   systemctl --user daemon-reload && systemctl --user enable --now sportsvyn-live-poller
# Promote it to a system unit whenever root is at hand; nothing in the process
# depends on which it is.
#
# EnvironmentFile IS THE PROJECT'S OWN .env.local, not a copy. A second copy of
# a credential is a second thing to rotate and a second thing to leak, and the
# one that gets forgotten is always the copy. systemd parses KEY=value lines,
# which is the shape that file already has.

[Unit]
Description=Sportsvyn live score poller (30s, NFL + CFB)
After=network-online.target
Wants=network-online.target
# StartLimitIntervalSec belongs in [Unit], not [Service] - systemd logs
# "Unknown key name" and IGNORES it there, which means a rate limit you believe
# you set and do not have. 0 disables the limit: a poller that systemd gives up
# restarting is a poller that is silently off all slate.
StartLimitIntervalSec=0

[Service]
Type=simple
User=derik
WorkingDirectory=/home/derik/projects/sportsvyn
EnvironmentFile=/home/derik/projects/sportsvyn/.env.local
# THE ABSOLUTE PATH, NOT `env node`. node here is nvm-installed under the
# user's home and is not on systemd's PATH - `/usr/bin/env node` exits 127
# ("No such file or directory") the moment the unit starts, which is how this
# was found. Pin the interpreter; an nvm upgrade is a deliberate edit here.
#
# --import services/_preload/prod-db.mjs SETS process.env.DATABASE_URL FROM
# PROD_DATABASE_URL BEFORE THE ENTRY MODULE'S OWN IMPORTS EVEN RESOLVE - not
# an in-file assignment, which import hoisting can outrun. This is the fix
# for a real bug: lib/wire/emit.js imports the SHARED lib/db.js (DATABASE_URL),
# not this process's own PROD-scoped client, and with EnvironmentFile pointing
# DATABASE_URL at DEV, every emit() call silently queried a database with no
# news_items table at all. Every droplet service uses this same preload now,
# one mechanism, not a per-service assignment that only some entrypoints had.
ExecStart=/home/derik/.nvm/versions/node/v22.23.1/bin/node --import ./services/_preload/prod-db.mjs services/live-poller/index.mjs

# RESTART ALWAYS, AND THE QUOTA COUNTER IS PERSISTED BECAUSE OF THIS LINE. A
# crash loop with an in-memory tally would spend a month's provider budget in an
# afternoon and the cap would never see it. RestartSec keeps a fast crash loop
# from becoming a fast request loop.
Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sportsvyn-live

# It writes to one database over HTTPS and reads two provider APIs. Nothing here
# needs to write to the filesystem.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=

[Install]
WantedBy=multi-user.target
