# sportsvyn-daily-tick.service
#
# INSTALL (--user unit, like the poller - this box has no passwordless sudo):
# installed and kept current by scripts/deploy-poller.sh --install-units
# (docs/ops/poller-deploy.md); the timer is enabled once, by hand:
#   systemctl --user enable --now sportsvyn-daily-tick.timer
#   journalctl --user -u sportsvyn-daily-tick -f
#
# RUNS FROM THE DEPLOY FOLDER (sun-12 item 7): systemd resolves
# %h/deploy/sportsvyn/current at each tick, so a deploy reaches the next tick
# with no restart, and a tick never runs a half-edited working checkout.
#
# A TIMER + ONESHOT SERVICE, NOT A LOOP - unlike sportsvyn-live-poller
# (a long-running process with its own 30s internal loop), this one exits
# after each tick; the timer unit is what owns the 5-minute cadence, and
# systemd's own timer accounting survives a droplet reboot better than an
# in-process setInterval would.
#
# EnvironmentFile IS THE PROJECT'S OWN .env.local - PUSH_ENABLED, the APNs
# key path, and PROD_DATABASE_URL all come from it, same reasoning as
# sportsvyn-live-poller.service: a second copy of a credential is a second
# thing to leak. --import services/_preload/prod-db.mjs sets DATABASE_URL
# from PROD_DATABASE_URL before any import can see the wrong one - the SAME
# preload sportsvyn-live-poller.service now uses, not a second, in-file
# mechanism (index.mjs used to do this itself; moved out so there is one
# way this works, everywhere, not two that happen to agree by coincidence).

[Unit]
Description=Sportsvyn Daily v2 edition tick (create board, fire daily-live/daily-revealed)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
# user unit: already runs as derik
WorkingDirectory=%h/deploy/sportsvyn/current
EnvironmentFile=%h/projects/sportsvyn/.env.local
ExecStart=%h/.nvm/versions/node/v22.23.1/bin/node --import ./services/_preload/prod-db.mjs services/daily-tick/index.mjs

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sportsvyn-daily-tick
# MEMORY CAP: a five-minute oneshot; 512M is several times any node process it
# has needed, and a wall rather than swap if one ever runs away.
MemoryHigh=384M
MemoryMax=512M
MemorySwapMax=128M

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=

[Install]
WantedBy=default.target
