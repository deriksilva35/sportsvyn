#!/usr/bin/env bash
# sportsvyn-stats [since-iso]  - Pulse usage numbers, key=value only, no PII/money.
set -u
umask 077
if [ $# -ge 1 ] && [ -n "$1" ]; then
  if ! printf '%s' "$1" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}([T ][0-9]{2}:[0-9]{2}(:[0-9]{2})?(\.[0-9]+)?(Z|[+-][0-9]{2}:?[0-9]{2})?)?$'; then
    echo "error=bad_since"; exit 2
  fi
  SINCE="$1"
else
  SINCE="$(date -u -d '24 hours ago' +%Y-%m-%dT%H:%M:%SZ)"
fi
ENV_FILE="$HOME/crew/secrets/crew-reader.env"
if [ ! -r "$ENV_FILE" ]; then echo "error=no_reader_env"; exit 3; fi
. "$ENV_FILE"
if [ -z "${CREW_READER_URL:-}" ]; then echo "error=no_reader_url"; exit 3; fi
ERRORS=0
q() {
  local key="$1" sql="$2" out rc
  out="$(printf '%s\n' "SET default_transaction_read_only = on;" "SET statement_timeout = '10s';" "$sql;" \
    | psql "$CREW_READER_URL" -X -q -At -v ON_ERROR_STOP=1 -v since="$SINCE" -f - 2>/dev/null)"
  rc=$?
  out="$(printf '%s\n' "$out" | tail -n 1)"
  if [ "$rc" -ne 0 ] || [ -z "$out" ]; then echo "$key=NA"; ERRORS=$((ERRORS+1)); else echo "$key=$out"; fi
}
echo "project=sportsvyn"; echo "since=$SINCE"; echo "until=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
# VERIFY users.created_at
q new_users "SELECT count(*) FROM users WHERE created_at >= :'since'::timestamptz"
# VERIFY daily_board_runs.created_at, contest_entries.updated_at, mock table user_id
q active_users "SELECT count(DISTINCT uid) FROM (SELECT user_id AS uid FROM daily_board_runs WHERE created_at >= :'since'::timestamptz UNION SELECT user_id FROM contest_entries WHERE updated_at >= :'since'::timestamptz UNION SELECT user_id FROM mock_drafts WHERE created_at >= :'since'::timestamptz) a WHERE uid IS NOT NULL"
# VERIFY daily_guest_runs.created_at / claimed_at
q guest_runs "SELECT count(*) FROM daily_guest_runs WHERE created_at >= :'since'::timestamptz"
q guest_claims "SELECT count(*) FROM daily_guest_runs WHERE claimed_at >= :'since'::timestamptz"
# VERIFY sessions created column
q sessions "SELECT count(*) FROM sessions WHERE created_at >= :'since'::timestamptz"
q daily_played "SELECT (SELECT count(*) FROM daily_board_runs WHERE created_at >= :'since'::timestamptz) + (SELECT count(*) FROM daily_guest_runs WHERE created_at >= :'since'::timestamptz)"
# VERIFY completed_at on both
q daily_finish_pct "SELECT coalesce(round(100.0*((SELECT count(*) FROM daily_board_runs WHERE created_at >= :'since'::timestamptz AND completed_at IS NOT NULL)+(SELECT count(*) FROM daily_guest_runs WHERE created_at >= :'since'::timestamptz AND completed_at IS NOT NULL))/NULLIF((SELECT count(*) FROM daily_board_runs WHERE created_at >= :'since'::timestamptz)+(SELECT count(*) FROM daily_guest_runs WHERE created_at >= :'since'::timestamptz),0),1),0)"
# VERIFY streak source
q daily_streak3_users "SELECT count(*) FROM user_streaks WHERE game = 'daily' AND current_streak >= 3"
# VERIFY contests.type values, meta game count, completion marker, score column
q pickem_played "SELECT count(DISTINCT e.user_id) FROM contest_entries e JOIN contests c ON c.id=e.contest_id WHERE c.type='pickem' AND e.updated_at >= :'since'::timestamptz"
q pickem_complete_pct "SELECT coalesce(round(100.0*avg(CASE WHEN (SELECT count(*) FROM jsonb_object_keys(e.lineup)) >= coalesce((c.meta->>'games')::int,0) THEN 1 ELSE 0 END),1),0) FROM contest_entries e JOIN contests c ON c.id=e.contest_id WHERE c.type='pickem' AND jsonb_typeof(e.lineup)='object' AND e.updated_at >= :'since'::timestamptz"
q draft_played "SELECT count(DISTINCT e.user_id) FROM contest_entries e JOIN contests c ON c.id=e.contest_id WHERE c.type='draft' AND e.updated_at >= :'since'::timestamptz"
q draft_complete_pct "SELECT coalesce(round(100.0*avg(CASE WHEN e.completed_at IS NOT NULL THEN 1 ELSE 0 END),1),0) FROM contest_entries e JOIN contests c ON c.id=e.contest_id WHERE c.type='draft' AND e.updated_at >= :'since'::timestamptz"
q gamedraft_played "SELECT count(DISTINCT e.user_id) FROM contest_entries e JOIN contests c ON c.id=e.contest_id WHERE c.type='draft_game' AND e.updated_at >= :'since'::timestamptz"
q gamedraft_avg_pts "SELECT coalesce(round(avg(e.score)::numeric,1),0) FROM contest_entries e JOIN contests c ON c.id=e.contest_id WHERE c.type='draft_game' AND e.score IS NOT NULL AND e.updated_at >= :'since'::timestamptz"
# VERIFY mock tables / sport / auto columns
q mock_nfl_played "SELECT count(*) FROM mock_drafts WHERE sport='nfl' AND created_at >= :'since'::timestamptz"
q mock_nba_played "SELECT count(*) FROM mock_drafts WHERE sport='nba' AND created_at >= :'since'::timestamptz"
q mock_auto_pct "SELECT coalesce(round(100.0*avg(CASE WHEN auto_finished THEN 1 ELSE 0 END),1),0) FROM mock_drafts WHERE created_at >= :'since'::timestamptz"
q mock_setups_saved "SELECT count(*) FROM mock_setups WHERE created_at >= :'since'::timestamptz"
# VERIFY members table
q leagues_created "SELECT count(*) FROM player_leagues WHERE created_at >= :'since'::timestamptz"
q leagues_avg_members "SELECT coalesce(round(avg(n)::numeric,1),0) FROM (SELECT l.id, count(m.league_id) AS n FROM player_leagues l LEFT JOIN league_members m ON m.league_id=l.id WHERE l.created_at >= :'since'::timestamptz GROUP BY l.id) x"
echo "errors=$ERRORS"
exit 0
